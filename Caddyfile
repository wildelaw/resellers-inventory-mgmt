{
    auto_https off
    debug
}

:443 {
    tls {$TLS_CERT} {$TLS_KEY}
    reverse_proxy app:3000

    # Rate limiting
    # auth_zone: 5 requests / 15 min per IP  -> applied to auth endpoints
    # api_zone:  100 requests / 15 min per IP -> applied to all other mutations
    @auth path /api/auth/*
    rate_limit {
        zone auth_zone {
            key {remote_host}
            events 5
            window 15m
        }
        zone api_zone {
            key {remote_host}
            events 100
            window 15m
        }
    }

    handle /api/auth/* {
        rate_limit auth_zone
        reverse_proxy app:3000
    }

    handle {
        rate_limit api_zone
        reverse_proxy app:3000
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

:8443 {
    tls {$TLS_CERT} {$TLS_KEY}
    reverse_proxy app:3000
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

:80 {
    redir https://{host}{uri} permanent
}